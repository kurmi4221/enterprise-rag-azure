APP_NAME=Enterprise RAG API
ENVIRONMENT=development
API_VERSION=v1

AZURE_AI_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
CHAT_DEPLOYMENT_NAME=gpt-5.1
EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small

AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_INDEX_NAME=enterprise-documents
AZURE_SEARCH_API_KEY=replace-with-azure-search-api-key

AZURE_STORAGE_ACCOUNT_URL=https://your-storage-account.blob.core.windows.net
AZURE_STORAGE_ACCOUNT_KEY=replace-with-storage-account-key
AZURE_BLOB_CONTAINER_NAME=enterprise-rag-documents

STORAGE_ACCOUNT_NAME=your-storage-account
STORAGE_CONTAINER_NAME=enterprise-rag-documents

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-postgres-password